# Copy to backup.env and fill in:  cp backup.env.example backup.env && chmod 600 backup.env

# Encryption password for the repository. Store a copy OFF the droplet
# (e.g. a password manager); without it the backups can't be restored.
# Generate one with: openssl rand -base64 32
RESTIC_PASSWORD=changeme

# --- Example: DigitalOcean Spaces (S3-compatible) -------------------------
RESTIC_REPOSITORY=s3:https://ams3.digitaloceanspaces.com/my-backup-bucket/selfhost
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# --- Example: Backblaze B2 (S3 API) ---------------------------------------
# RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/my-backup-bucket/selfhost
# AWS_ACCESS_KEY_ID=<keyID>
# AWS_SECRET_ACCESS_KEY=<applicationKey>

# --- Example: SFTP to another machine (uses root's SSH key) ---------------
# RESTIC_REPOSITORY=sftp:backupuser@backup-host:/srv/backups/selfhost
