# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env

DOMAIN=example.com
ACME_EMAIL=you@example.com

# Cloudflare API token with Zone:DNS:Edit permission for your domain
CF_DNS_API_TOKEN=changeme

# Public IP of the droplet (or a DNS name pointing to it, NOT covered by the wildcard)
WG_HOST=203.0.113.10
WG_ADMIN_USER=admin
# wg-easy enforces a strong password (12+ chars, mixed case, number, symbol)
WG_ADMIN_PASSWORD=changeme

TZ=Europe/London
CURRENCY=GBP
